    "@sinclair/typebox": "^0.34.30"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsdown": "^0.12.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14"
  }
}
