{
  "name": "claude-monitor",
  "version": "0.0.1",
  "description": "Monitor tool for Claude Code CLI instances",
  "type": "module",
  "bin": {
    "claude-monitor": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsdown watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
